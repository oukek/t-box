{
  "name": "@t-box/errors",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./*": { "types": "./dist/*.d.ts", "import": "./dist/*.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "devDependencies": { "typescript": "~5.9.3" }
}
