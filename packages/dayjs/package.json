{
  "name": "@t-box/dayjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "dayjs": "1.11.23"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "^24.10.0"
  }
}
