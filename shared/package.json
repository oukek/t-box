    "@t-box/converter-contracts": "workspace:*",
    "@t-box/ledger-contracts": "workspace:*",
    "@t-box/market-contracts": "workspace:*",
    "@t-box/settings-contracts": "workspace:*",
    "@t-box/time-contracts": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
