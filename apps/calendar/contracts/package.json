{
  "name": "@t-box/calendar-contracts",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@t-box/app-contracts": "workspace:*",
    "@t-box/dayjs": "workspace:*",
    "@t-box/time-contracts": "workspace:*",
    "lunar-typescript": "1.8.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "~5.9.3"
  }
}
