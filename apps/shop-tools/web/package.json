    "@t-box/ui-kit": "workspace:*",
    "exceljs": "4.4.0",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.9",
    "typescript": "~5.9.3",
    "vite": "8.3.2",
    "vue-tsc": "^3.2.5"
  }
}
