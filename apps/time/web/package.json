{
  "name": "@t-box/time-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./*.vue": "./src/*.vue",
    "./*.css": "./src/*.css"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "dev": "vite --host 0.0.0.0 --port 5179 --strictPort",
    "build": "vue-tsc --noEmit && vite build && node ../../../scripts/build-application-artifact.mjs time"
  },
  "dependencies": {
    "@t-box/app-contracts": "workspace:*",
    "@t-box/app-sdk": "workspace:*",
    "@t-box/app-web-sdk": "workspace:*",
    "@t-box/device-reminders": "workspace:*",
    "@t-box/shared": "workspace:*",
    "@t-box/time-contracts": "workspace:*",
    "@t-box/ui-kit": "workspace:*",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.9",
    "typescript": "~5.9.3",
    "vite": "8.3.2",
    "vue-tsc": "^3.2.5"
  }
}
