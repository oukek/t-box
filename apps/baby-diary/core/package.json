{
  "name": "@t-box/baby-diary-core",
  "type": "module",
  "version": "1.2.2",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@t-box/baby-diary-contracts": "workspace:*",
    "@t-box/dayjs": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
