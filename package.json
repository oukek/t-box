{
  "name": "t-box",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "check": "pnpm lint && pnpm check:apps && pnpm typecheck",
    "test:unit": "pnpm test && pnpm test:ui-components && pnpm test:app-sdk && pnpm test:native",
    "dev": "pnpm build:contracts && concurrently --kill-others -n api,app,admin,calculator,artifacts,packages -c cyan,green,magenta,blue,white,yellow \"pnpm dev:api\" \"pnpm dev:app\" \"pnpm dev:admin\" \"pnpm dev:apps\" \"node scripts/serve-application-artifacts.mjs 6176 0.0.0.0\" \"pnpm dev:packages\"",
    "dev:app": "pnpm --filter @t-box/app dev",
    "dev:api": "pnpm --filter @t-box/api dev",
    "build": "pnpm build:contracts && pnpm --filter @t-box/api --filter @t-box/app --filter @t-box/admin --filter @t-box/calculator-web build",
    "pack": "pnpm build:contracts && pnpm --filter @t-box/app --filter @t-box/calculator-web build",
    "typecheck": "pnpm build:contracts && pnpm -r typecheck",
    "test": "pnpm build:contracts && pnpm --filter @t-box/api test",
    "test:chat": "pnpm build:contracts && pnpm --filter @t-box/api test:chat",
    "db:init": "pnpm build:contracts && pnpm --filter @t-box/api db:init",
    "native:sync": "node scripts/native.mjs sync",
    "native:ios": "node scripts/native.mjs open ios",
    "native:android": "node scripts/native.mjs open android",
    "native:dev:ios": "node scripts/native.mjs dev ios",
    "native:dev:android": "node scripts/native.mjs dev android",
    "admin:init": "pnpm --filter @t-box/api admin:init",
    "dev:admin": "pnpm --filter @t-box/admin dev",
    "test:admin": "pnpm build:contracts && pnpm --filter @t-box/api test:admin",
    "test:categories": "pnpm build:contracts && pnpm --filter @t-box/api test:categories",
    "user:init": "pnpm --filter @t-box/api user:init",
    "test:ledgers": "pnpm build:contracts && pnpm --filter @t-box/api test:ledgers",
    "test:consent": "pnpm build:contracts && pnpm --filter @t-box/api test:consent",
    "test:media": "pnpm build:contracts && pnpm --filter @t-box/api test:media",
    "test:identity": "pnpm build:contracts && pnpm --filter @t-box/api test:identity",
    "test:ui-components": "pnpm --filter @t-box/api exec tsx --test ../app/test/*.test.ts",
    "native:version": "pnpm --filter @t-box/capacitor sync:version",
    "native:run:ios": "node scripts/native.mjs run ios",
    "native:run:android": "node scripts/native.mjs run android",
    "test:native": "node --test capacitor/scripts/*.test.mjs",
    "test:tasks": "pnpm build:contracts && pnpm --filter @t-box/api test:tasks",
    "test:presentation": "pnpm build:contracts && pnpm --filter @t-box/api test:presentation",
    "test:billing": "pnpm build:contracts && pnpm --filter @t-box/api test:billing",
    "test:wechat": "pnpm build:contracts && pnpm --filter @t-box/api test:wechat",
    "test:calendar-time": "pnpm build:contracts && pnpm --filter @t-box/api test:calendar-time",
    "test:desktop": "pnpm build:contracts && pnpm --filter @t-box/api test:desktop",
    "build:contracts": "pnpm -r --filter \"./packages/**\" --filter \"./apps/*/contracts\" --filter \"./apps/*/server\" --filter @t-box/shared --if-present build",
    "dev:apps": "pnpm --filter @t-box/calculator-web dev",
    "test:app-platform": "pnpm build:contracts && pnpm --filter @t-box/api exec tsx test/app-platform.integration.ts",
    "dev:packages": "pnpm -r --parallel --filter \"./packages/**\" --filter \"./apps/*/contracts\" --filter \"./apps/*/server\" --filter @t-box/shared --if-present dev",
    "serve:apps": "node scripts/serve-application-artifacts.mjs",
    "test:app-publishing": "pnpm build:contracts && pnpm --filter @t-box/api exec tsx test/publishing.integration.ts",
    "check:apps": "node scripts/check-application-boundaries.mjs",
    "test:app-sdk": "pnpm --filter @t-box/app-contracts --filter @t-box/app-sdk --filter @t-box/app-web-sdk build && pnpm --filter @t-box/app-sdk --filter @t-box/app-web-sdk test && pnpm --filter @t-box/api exec tsx --test ../app/test/application-sdk.test.ts",
    "test:holidays": "pnpm build:contracts && pnpm --filter @t-box/api test:holidays",
    "test:workflow": "pnpm build:contracts && pnpm --filter @t-box/api test:workflow",
    "test:context": "pnpm build:contracts && pnpm --filter @t-box/api test:context",
    "test:messages": "pnpm build:contracts && pnpm --filter @t-box/api test:messages",
    "test:answer-retry": "pnpm build:contracts && pnpm --filter @t-box/api test:answer-retry",
    "test:ledger-features": "pnpm build:contracts && pnpm --filter @t-box/api test:ledger-features",
    "test:category-presets": "pnpm build:contracts && pnpm --filter @t-box/api exec tsx test/category-presets.integration.ts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "concurrently": "^10.0.5",
    "eslint": "10.12.0",
    "eslint-plugin-format": "2.0.1",
    "prettier": "^3.9.9",
    "typescript": "5.9.3"
  }
}
