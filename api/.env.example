# 本地开发：复制为 api/.env，只需修改 MySQL 和可选 Redis。
# 生产 PM2 使用 deploy/pm2/api.env.example；完整高级选项见 docs/api-environment.md。

MYSQL_HOST=127.0.0.1:3306
MYSQL_USERNAME=root
MYSQL_PASSWORD='replace_me'
MYSQL_DATABASE=t_box

# Redis 可选；不使用时将 REDIS_ADDR 留空。
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=5

# 本地默认把文件保存在 api/.storage/resources，不需要真实 OSS 凭据。
# 本地也要接 OSS 时，取消下面三行注释并填写；Bucket 默认 tboxos。
# OSS_REGION=cn-hangzhou
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=

# 跨域默认放行全部来源，包括对话、账本和应用市场 WebSocket。
# 后台自动回显来源以支持 Cookie；登录鉴权和管理请求头校验仍生效。
# 默认信任本机回环代理，本地应用资源为 http://localhost:6176，API 内运行恢复器。
# Actions 发布包自动携带应用域名、OSS 模式、桶地址和 builds 目录，无须在服务器重复配置。
# 微信支付和 AI 密钥在项目后台填写；Actions 上传凭据和应用导入 Token 在 GitHub 配置。
# 生产业务文件 OSS 上传凭据还须填写服务器 shared/api.env，详见生产模板。
# api/.secrets/provider.key 自动生成，须与数据库一起备份。

# 宝宝日记等私有应用附件：独立私有读写桶，与公共资源桶不同；共用服务端 OSS 凭据和地域。
# 未配置时生产禁用私有上传；开发使用 api/.storage/private。
OSS_PRIVATE_RESOURCE_BUCKET=
