HOST=127.0.0.1
PORT=3000
MYSQL_HOST=127.0.0.1:3306
MYSQL_USERNAME=t_box
MYSQL_PASSWORD='replace_with_server_mysql_password'
MYSQL_DATABASE=t_box
REDIS_ADDR=127.0.0.1:3508
REDIS_PASSWORD='replace_with_server_redis_password'
REDIS_DB=5
CORS_ORIGINS=https://box.example.com,https://admin.example.com,capacitor://localhost,http://localhost,https://localhost
ADMIN_ORIGINS=https://admin.example.com
TRUSTED_PROXIES=127.0.0.1,::1
# Public custom HTTPS domain of the applications OSS website.
APP_ARTIFACT_ORIGIN=https://apps.example.com
# OSS mode starts API + worker; static files are uploaded by Actions.
APP_ARTIFACT_DELIVERY=oss
# Only used by the optional legacy local artifact server.
ARTIFACT_PORT=6176
# Optional CI application import. Public applications bucket HTTPS origin, without trailing slash.
APP_IMPORT_OSS_ORIGIN=https://tboxos-app.oss-cn-hangzhou.aliyuncs.com
APP_IMPORT_OSS_PREFIX=builds
