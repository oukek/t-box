# 生产 PM2：保存为 /www/wwwroot/tbox/shared/api.env，权限 600。
# 填写服务器 MySQL、业务文件 OSS 密钥和可选 Redis；不要在升级时覆盖已有配置。

PORT=6868

MYSQL_HOST=127.0.0.1:3306
MYSQL_USERNAME=t_box
MYSQL_PASSWORD='replace_with_server_mysql_password'
MYSQL_DATABASE=t_box

# Redis 可选；不使用时将 REDIS_ADDR 留空，否则填写实际端口和密码。
# Redis 不可用时健康状态为 degraded，回退 MySQL；发布仅告警，不因此停止服务。
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=5

# 必填：API 上传用户文件、AI 图片和记账图片，写入 tboxos/uploads/resources/。
# 对象公开读，预览 / 下载不需要签名；上传和删除仍需要下面的服务器密钥。
# 使用服务器专用 RAM 用户密钥；不会从 GitHub Secrets 自动同步到服务器。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# OSS_REGION 由 Actions 发布包自动提供；手工部署时才填写实际地域。
# OSS_REGION=cn-hangzhou
# OSS_RESOURCE_BUCKET=tboxos

# 自动设置：生产环境、API 监听 127.0.0.1:6868、独立恢复 worker、本机可信代理。
# 普通 API 跨域默认开放；后台仅允许 Actions 发布包记录的 admin 域名携带 Cookie。
# 应用域名、OSS 交付模式、构建桶地址和目录从 Actions 发布包读取，不用在此重复填写。
# 微信支付 / AI 密钥在项目后台填写；Actions 的上传密钥与应用导入 Token 在 GitHub 填写。
# APP_IMPORT_TOKEN 由 PM2 部署自动同步哈希，不在此手填，也不需要定期续期。
# shared/secrets/provider.key 自动生成，须与数据库一起备份。
# 自定义监听端口、代理拓扑或来源限制等高级选项见 docs/api-environment.md。

# 宝宝日记附件共用业务文件桶，写入 uploads/resources/application-files/。
# 所有上传对象使用独立的 256 位随机名称；应用附件保留对象级 private ACL，无需另建桶或填写配置。
