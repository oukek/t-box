# Add to the API-domain HTTPS website's server {} block. Do not strip /api/.
location /api/ {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_buffering off;
    client_max_body_size 40m;
}
# WeChat public-account ownership file, when the OAuth callback domain is this API domain.
# Place the exact MP_verify_*.txt from WeChat in shared/wechat/. This directory contains public verification files only.
location ~ ^/MP_verify_[A-Za-z0-9]+\.txt$ {
    root /www/wwwroot/tbox/shared/wechat;
    try_files $uri =404;
    default_type text/plain;
}
