# Add to the API-domain HTTPS website's server {} block. Do not strip /api/.
location /api/ {
    proxy_pass http://127.0.0.1:6868;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_buffering off;
    client_max_body_size 40m;
}
# Optional: WeChat public-account verification for this API OAuth callback domain.
# Replace BOTH placeholders with WeChat's exact filename and file content, then uncomment.
# Nginx returns the verification text directly; no persistent verification file is needed.
# location = /MP_verify_REPLACE.txt {
