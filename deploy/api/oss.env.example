# Copy to oss.env on the server. This is trusted shell configuration.
# Credentials belong in ossutil's private profile or environment, not the API .env.
OSS_BUCKET=tboxos-admin
OSS_PREFIX=docker
OSS_REGION=cn-hangzhou
# Same-region ECS can use the internal endpoint. Actions uses the PUBLIC endpoint.
OSS_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
# Optional: select a configured read-only ossutil profile.
# OSSUTIL_CONFIG_FILE=/root/.ossutilconfig
# OSSUTIL_PROFILE=default
