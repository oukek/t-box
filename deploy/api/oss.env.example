# Copy to oss.env on the server and chmod 600. This is trusted shell configuration.
# These download credentials are separate from the running API .env.
OSS_BUCKET=tboxos-admin
OSS_PREFIX=docker
OSS_REGION=cn-hangzhou
# Same-region ECS can use the internal endpoint. Actions uses the PUBLIC endpoint.
OSS_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Optional temporary credentials; update before expiration.
# OSS_SESSION_TOKEN=
