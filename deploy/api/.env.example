# Copy to .env on the SERVER; never commit the real .env.
# deploy-release.sh writes the verified local tag here after a healthy deployment.
# This placeholder will never be pulled; use the script for the first deployment.
API_IMAGE=t-box-api:not-installed
API_PORT=3000
ARTIFACT_PORT=6176
# Must differ from frontend and admin origins (iframe isolation).
APP_ARTIFACT_ORIGIN=https://apps.example.com
# Optional CI application import. Exact private OSS bucket HTTPS origin, without trailing slash.
APP_IMPORT_OSS_ORIGIN=https://your-private-bucket.oss-cn-hangzhou.aliyuncs.com
APP_IMPORT_OSS_PREFIX=t-box/apps

# These are SERVER services, not the development computer's services.
# Host networking allows access to host-installed services on 127.0.0.1.
MYSQL_HOST=127.0.0.1:3306
MYSQL_USERNAME=t_box
MYSQL_PASSWORD='replace_with_server_mysql_password'
MYSQL_DATABASE=t_box
REDIS_ADDR=127.0.0.1:3508
REDIS_PASSWORD='replace_with_server_redis_password'
REDIS_DB=5
CORS_ORIGINS=https://box.example.com,https://admin.example.com,capacitor://localhost,http://localhost,https://localhost
TRUSTED_PROXIES=127.0.0.1,::1
