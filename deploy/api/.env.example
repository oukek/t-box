# 可选 Docker 部署使用；当前正式方案为 deploy/pm2/api.env.example。
# deploy-release.sh 健康检查成功后写入实际镜像标签，不会拉取占位标签。
API_IMAGE=t-box-api:not-installed
API_PORT=3000
# 应用由 OSS 提供，需要独立 HTTPS 域名；PM2 Actions 方案自动携带此配置。
APP_ARTIFACT_ORIGIN=https://apps.example.com
ADMIN_ORIGINS=https://admin.example.com

MYSQL_HOST=127.0.0.1:3306
MYSQL_USERNAME=t_box
MYSQL_PASSWORD='replace_with_server_mysql_password'
MYSQL_DATABASE=t_box
# Redis 可选；不使用时将 REDIS_ADDR 留空。
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=5

# 生产业务文件存储：独立于用于下载 Docker 包的 oss.env。
OSS_REGION=cn-hangzhou
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 宝宝日记附件共用业务桶，以随机对象名和对象级 private ACL 存储，无需独立桶配置。
# Bucket 默认 tboxos，业务文件目录固定 uploads/resources/。

# Compose 自动设置 production、127.0.0.1 和 API_PORT，API 内运行恢复器。
# 后台来源必须填写上面的 ADMIN_ORIGINS；默认信任本机反向代理。
# 微信支付 / AI 密钥在项目后台配置；data/secrets/provider.key 须与数据库一起备份。
