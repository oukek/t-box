{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "T方舟开发版",
  "identifier": "cn.tboxos.desktop.dev",
  "build": { "beforeBuildCommand": "node build-ui.mjs", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "create": false, "title": "T方舟", "width": 1180, "height": 780, "minWidth": 720, "minHeight": 480 }],
    "security": { "capabilities": ["main"] }
  },
  "plugins": { "updater": { "pubkey": "", "requireSignedVersion": true } },
  "bundle": { "active": true, "targets": ["app"], "macOS": { "signingIdentity": "-" }, "icon": ["icons/icon.icns"] }
}
