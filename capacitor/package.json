{
  "name": "@t-box/capacitor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "sync": "node ../scripts/native.mjs sync",
    "open:ios": "node ../scripts/native.mjs open ios",
    "open:android": "node ../scripts/native.mjs open android",
    "sync:version": "node scripts/sync-native-version.mjs",
    "build:web": "pnpm --dir .. pack",
    "copy:web": "node scripts/copy-web-assets.mjs",
    "dev:ios": "node ../scripts/native.mjs dev ios",
    "dev:android": "node ../scripts/native.mjs dev android",
    "run:ios": "node ../scripts/native.mjs run ios",
    "run:android": "node ../scripts/native.mjs run android",
    "sync:wechat": "node scripts/sync-wechat-config.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@t-box/capacitor-native-scanner": "workspace:*",
    "@t-box/capacitor-wechat-pay": "workspace:*"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/node": "^22.18.0",
    "plist": "3.1.0",
    "typescript": "~5.9.3"
  }
}
